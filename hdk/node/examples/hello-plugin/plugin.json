{
  "name": "hello-plugin-node",
  "version": "0.1.0",
  "api_version": "v1",
  "description": "Hello World plugin written in Node.js TypeScript",
  "author": "developer",
  "priority": 100,
  "failure_policy": "fail_close",
  "timeout_ms": 1000,
  "runtime": {
    "language": "node",
    "command": "node",
    "args": ["dist/index.js"]
  },
  "permissions": [
    "request.read",
    "request.modify"
  ],
  "hooks": [
    "request.before"
  ]
}
