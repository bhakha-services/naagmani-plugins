{
  "name": "hello-plugin-python",
  "version": "0.1.0",
  "api_version": "v1",
  "description": "Hello World plugin in Python",
  "author": "developer",
  "priority": 100,
  "failure_policy": "fail_close",
  "timeout_ms": 1000,
  "runtime": {
    "language": "python",
    "command": "python",
    "args": ["main.py"]
  },
  "permissions": [
    "request.read",
    "request.modify"
  ],
  "hooks": [
    "request.before"
  ]
}
