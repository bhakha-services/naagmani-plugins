{
  "name": "mcp",
  "version": "1.0.0",
  "api_version": "v1",
  "description": "Naagmani Model Context Protocol (MCP) Tool Execution Plugin",
  "author": "Naagmani Tool Team",
  "priority": 40,
  "failure_policy": "fail_open",
  "timeout_ms": 1500,
  "runtime": {
    "language": "node",
    "command": "node",
    "args": ["dist/index.js"]
  },
  "permissions": [
    "request.read",
    "request.modify"
  ],
  "capabilities": [
    "tools.mcp",
    "tools.function"
  ],
  "hooks": [
    "request.before"
  ]
}
