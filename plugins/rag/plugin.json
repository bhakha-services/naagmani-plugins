{
  "name": "rag",
  "version": "1.0.0",
  "api_version": "v1",
  "description": "Naagmani Retrieval-Augmented Generation (RAG) & Knowledge Plugin",
  "author": "Naagmani Knowledge Team",
  "priority": 30,
  "failure_policy": "fail_open",
  "timeout_ms": 1500,
  "runtime": {
    "language": "python",
    "command": "python",
    "args": ["main.py"]
  },
  "permissions": [
    "request.read",
    "request.modify"
  ],
  "capabilities": [
    "knowledge.rag",
    "knowledge.retrieval"
  ],
  "hooks": [
    "request.before"
  ]
}
