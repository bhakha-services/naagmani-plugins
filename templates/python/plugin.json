{
  "name": "my-py-plugin",
  "version": "0.1.0",
  "api_version": "v1",
  "description": "A starter Naagmani plugin built with Python",
  "author": "developer",
  "priority": 100,
  "failure_policy": "fail_close",
  "timeout_ms": 500,
  "runtime": {
    "language": "python",
    "command": "python",
    "args": ["main.py"]
  },
  "permissions": [
    "request.read"
  ],
  "hooks": [
    "request.before"
  ]
}
